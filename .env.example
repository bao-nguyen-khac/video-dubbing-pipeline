# Copy file này thành .env rồi điền giá trị thật (.env đã nằm trong .gitignore)

# Endpoint OpenAI-compatible của dịch vụ AI ("9router"), ví dụ http://172.16.57.147:20128/v1
ROUTER_BASE_URL=http://localhost:20128/v1

# API key tương ứng
ROUTER_API_KEY=

# Model dùng cho script_gen (dịch/viết lại kịch bản), ví dụ ag/gemini-3-flash-agent
ROUTER_MODEL=gpt-4o-mini

# Timeout (giây) mỗi lượt gọi 9router — hết hạn thì chuyển sang OpenRouter dự
# phòng bên dưới. Để trống dùng mặc định 120s.
ROUTER_TIMEOUT=120

# Trần token đầu ra mỗi lượt gọi LLM. Để trống dùng mặc định 16384.
# CẢNH BÁO với model dạng reasoning/agent (vd `ag/gemini-3-flash-agent`): loại
# này đốt rất nhiều token cho phần suy luận nội bộ TRƯỚC khi trả lời — đo thật
# thấy 3933/4092 token là suy luận, chỉ còn ~160 token để trả lời nên output bị
# cắt ngang giữa chừng. Trần quá thấp = job chết ở bước viết kịch bản.
ROUTER_MAX_TOKENS=16384

# Số nhịp gửi trong 1 lượt gọi khi dịch/viết lại. Để trống dùng mặc định 25.
# Hạ xuống nếu vẫn gặp lỗi cắt output (mỗi lượt phải trả ít dòng hơn); nâng lên
# nếu muốn model có ngữ cảnh rộng hơn quanh mỗi câu. Lô nào trả hụt dòng sẽ tự
# được chia đôi và thử lại, nên giá trị này không phải điểm hỏng cứng.
ROUTER_SEGMENT_CHUNK_SIZE=25

# ── OpenRouter dự phòng (tuỳ chọn) ───────────────────────────────────────────
# Khi 9router timeout / không kết nối được / trả lỗi, script_gen tự gọi lại qua
# OpenRouter thay vì làm hỏng job. Bỏ trống OPENROUTER_API_KEY = tắt fallback.
# Lấy key tại https://openrouter.ai/keys
#
# Lưu ý: fallback chỉ áp dụng cho dịch/viết kịch bản (LLM). Provider giọng đọc
# 'router-tts' vẫn cần 9router vì OpenRouter không có endpoint /audio/speech —
# khi 9router chết, dùng edge-tts hoặc lucyai.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model bên OpenRouter (KHÁC ROUTER_MODEL — id model của 9router không tồn tại ở đây)
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Cookie TikTok/Douyin (bắt buộc, f2 cần để lấy msToken hợp lệ) ─────────────
# Không có cookie thật, f2 tự sinh "fake msToken" và bị nền tảng từ chối với lỗi
# "msToken 内容不符合要求".
#
# Cách lấy TIKTOK_COOKIE:
#   1. Đăng nhập tiktok.com bằng trình duyệt (Chrome/Edge/Firefox)
#   2. Mở DevTools (F12) → tab Network → reload trang → click bất kỳ request nào
#      tới tiktok.com → tab Headers → copy toàn bộ giá trị header "Cookie"
#   3. Dán nguyên chuỗi đó vào TIKTOK_COOKIE bên dưới (1 dòng, không xuống dòng)
# Cookie hết hạn sau một thời gian (ttwid/msToken có thời hạn) — lặp lại các
# bước trên nếu download lại bắt đầu lỗi.
TIKTOK_COOKIE=

# Tương tự cho douyin.com (chỉ cần nếu bạn tải video Douyin)
DOUYIN_COOKIE=

# ── Nhận dạng giọng nói (ASR / faster-whisper) ───────────────────────────────
# Whisper là model ĐA NGÔN NGỮ (~99 thứ tiếng) và mặc định TỰ NHẬN DIỆN ngôn
# ngữ của clip — tiếng Trung/Nhật/Hàn/Thái... chạy được sẵn, không cần cấu hình.
# Hai biến dưới đây chỉ cần khi muốn tinh chỉnh.

# Ghim ngôn ngữ nguồn thay vì để tự đoán. Để TRỐNG = tự nhận diện.
# Việc tự đoán chỉ nghe 30 GIÂY ĐẦU nên dễ sai khi clip mở đầu bằng nhạc/tiếng
# ồn hoặc nói xen kẽ 2 thứ tiếng — khi đó ghim mã ngôn ngữ vào đây.
# Mã thông dụng: en (Anh), zh (Trung), ja (Nhật), ko (Hàn), vi (Việt), th (Thái)
WHISPER_LANGUAGE=

# Kích thước model: tiny | base | small | medium | large-v3. Mặc định 'small'.
# 'small' đủ tốt cho tiếng Anh nhưng kém rõ rệt với tiếng Trung/Nhật/Hàn —
# lên 'medium' hoặc 'large-v3' nếu cần chính xác hơn (chậm hơn nhiều trên CPU).
WHISPER_MODEL=

# ── Web UI (feature 002-web-ui) ────────────────────────────────────────────
# Tài khoản đăng nhập giao diện web — chỉ 1 cặp duy nhất, không phải hệ thống
# nhiều user (xem specs/002-web-ui/spec.md, Clarification Q1)
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=

# Secret dùng để ký session cookie (itsdangerous) — đổi sang chuỗi ngẫu nhiên
# dài khi dùng thật, không để trống
WEB_UI_SECRET_KEY=

# ── Vivibe (LucyAI) TTS (feature 004-voice-selection-preview, tuỳ chọn) ───────
# Provider giọng đọc thứ 2 bên cạnh edge-tts, trả phí, cần tài khoản riêng.
# Không cấu hình vẫn dùng được toàn bộ tính năng với edge-tts (không lỗi).
#
# Cách lấy VIVIBE_API_KEY:
#   1. Tạo tài khoản tại https://www.vivibe.app
#   2. Vào phần API/Developer, tạo API key mới — key chỉ hiển thị 1 lần lúc
#      tạo, copy và lưu lại ngay (xem https://www.vivibe.app/api-docs.html)
#   3. Cấu hình sẵn ít nhất 1 giọng đọc ("voice") trong tài khoản Vivibe —
#      nếu chưa có giọng nào, GET /api/voices sẽ chỉ trả về giọng edge-tts
VIVIBE_API_KEY=

# ── Zernio — đăng video lên TikTok/YouTube (feature 006-publish-video-tab) ────
# Dịch vụ trung gian đã được TikTok/YouTube cấp phép đăng bài tự động. Không có
# key thì mọi thứ khác vẫn chạy bình thường, chỉ tab "Đăng video" báo chưa cấu
# hình (không ảnh hưởng pipeline xử lý video).
#
# Cách lấy ZERNIO_API_KEY:
#   1. Tạo tài khoản tại https://zernio.com
#   2. Vào dashboard → API keys → tạo key mới (dạng sk_ + 64 ký tự hex)
#   3. Liên kết kênh TikTok/YouTube ngay trong giao diện web của hệ thống này
#      (tab "Đăng video" → "Kết nối kênh"), không cần làm thủ công trên Zernio
#
# LƯU Ý CHI PHÍ: Zernio tính tiền theo số kênh đã kết nối. Mỗi lượt đăng thành
# công tạo bài đăng CÔNG KHAI thật trên kênh của bạn và giao diện này KHÔNG
# xoá/sửa lại được (phải vào app/website gốc của nền tảng).
ZERNIO_API_KEY=

# Base URL API (đã gồm /v1). Chỉ đổi khi Zernio đổi endpoint.
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Profile Zernio dùng để nhóm các kênh. Để TRỐNG ở lần đầu — hệ thống tự lấy
# profile mặc định từ tài khoản và ghi nhớ vào publish_data/state.json.
ZERNIO_PROFILE_ID=
